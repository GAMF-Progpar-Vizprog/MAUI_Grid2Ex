<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAUI_Grid2Ex.MainPage">

	<Grid RowDefinitions="Auto,*,Auto,Auto" Margin="5">
		<Label Text="Using the grid" HorizontalOptions="Start"
                   FontSize="18" BackgroundColor="Yellow" Grid.Row="0"/>
		<Label Text="Placing text in the middle" VerticalOptions="Center" Grid.Row="1"
                   HorizontalTextAlignment="Center" FontSize="24" BackgroundColor="Yellow"/>
		<Label Text="Right alignment" Grid.Row="2"       
                   HorizontalTextAlignment="End" FontSize="24" BackgroundColor="Yellow"/>
		<Grid ColumnDefinitions="Auto,*,Auto"  Grid.Row="3" BackgroundColor="DarkGreen">
			<Button Text="Left Button" HeightRequest="50"
                    Grid.Column="0"/>
			<Button Text="Right Button" HeightRequest="50"
                    Grid.Column="2"/>
		</Grid>
	</Grid>

</ContentPage>
